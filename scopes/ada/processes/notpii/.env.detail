# Copiar este archivo como .env solo para ejecución local.
# .env contiene valores reales y no debe versionarse ni viajar en logs.

# Identidad del runtime.
ENVIRONMENT=local
APPLICATION=ada-notpii
VOLUMEN_PATH=/absolute/path/to/volume

# Identidad organizacional usada por Key Vault en ambientes desplegados.
COMPANY_ABREV=company
PRODUCT_ABREV=product

# Service Bus INTERPOLATED.
# Solo es obligatorio si el catálogo contiene tags INTERPOLATED activos.
NOTPII_INTERPOLATED_SERVICE_BUS_CONNECTION_STRING=
NOTPII_INTERPOLATED_SERVICE_BUS_TOPIC_NAME=
NOTPII_INTERPOLATED_SERVICE_BUS_SUBSCRIPTION_NAME=
NOTPII_INTERPOLATED_SERVICE_BUS_MAX_WAIT_TIME_SECONDS=10

# Service Bus RECORDED.
# Solo es obligatorio si el catálogo contiene tags RECORDED activos.
NOTPII_RECORDED_SERVICE_BUS_CONNECTION_STRING=
NOTPII_RECORDED_SERVICE_BUS_TOPIC_NAME=
NOTPII_RECORDED_SERVICE_BUS_SUBSCRIPTION_NAME=
NOTPII_RECORDED_SERVICE_BUS_MAX_WAIT_TIME_SECONDS=10

# Adquisición NOTPII.
# Cada iteración toma como máximo 10 mensajes del modo seleccionado.
# El proceso alterna INTERPOLATED/RECORDED entre iteraciones y mantiene PeekLock hasta
# confirmar dataset + producer state. RAW_BATCH_SIZE controla lectura interna del Parquet.
NOTPII_MAX_MESSAGE_COUNT=10
NOTPII_RAW_BATCH_SIZE=100000

# Observabilidad Azure.
ATLANTICUS_AZURE_OBSERVABILITY_MODE=off
ATLANTICUS_AZURE_OBSERVABILITY_PROFILE=slim
APPLICATION_INSIGHTS_CONNECTION_STRING=
