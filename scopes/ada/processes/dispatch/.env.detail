ENVIRONMENT=local
COMPANY_ABREV=MLP
PRODUCT_ABREV=ADA
APPLICATION=ada-dispatch-local
VOLUMEN_PATH=/tmp/atlanticus
SQL_CONNECTION_STRING_DISPATCH=<sql-connection-string>
SQL_QUERY_TIMEOUT_SECONDS_DISPATCH=200
SQL_BATCH_SIZE_DISPATCH=10000
SQL_MAX_QUERY_ROWS_DISPATCH=500000
DISPATCH_SQL_RETRY_ATTEMPTS=10
DISPATCH_SQL_RETRY_DELAY_SECONDS=5
ATLANTICUS_OBSERVABILITY_FILE_LOGS_ENABLED=true
ATLANTICUS_AZURE_OBSERVABILITY_MODE=off
ATLANTICUS_AZURE_OBSERVABILITY_PROFILE=slim
APPLICATION_INSIGHTS_CONNECTION_STRING=
