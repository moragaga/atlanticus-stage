ENVIRONMENT=local
COMPANY_ABREV=MLP
PRODUCT_ABREV=ADA
APPLICATION=ada-operaciones-integradas-local
VOLUMEN_PATH=/tmp/atlanticus
COSMOS_CONSUMPTION_ENDPOINT=http://localhost:8081
