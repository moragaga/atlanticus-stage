ENVIRONMENT=local
COMPANY_ABREV=MLP
PRODUCT_ABREV=ADA
APPLICATION=ada-remanentes-local
VOLUMEN_PATH=/tmp/atlanticus
STORAGE_ACCOUNT_CONNECTION_STRING_REMANENTES=<storage-connection-string>
