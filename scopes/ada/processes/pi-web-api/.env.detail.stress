# Copiar este archivo como .env dentro del artifact para ejecutar el benchmark PI Web API.
# Este archivo es exclusivo de la prueba de stress y no debe usarse como configuración productiva.
# Los valores marcados COMPLETAR deben ser reemplazados antes de ejecutar.

# =============================================================================
# COMPLETAR: RUNTIME LOCAL
# =============================================================================

ENVIRONMENT=local
APPLICATION=ada-pi-web-api-stress

# COMPLETAR: ruta absoluta a un volumen NUEVO y aislado para esta prueba.
# Ejemplo: /home/moraga/mlp/repository/atlanticus-stage/artifacts/.local-volume-pi-stress
VOLUMEN_PATH=COMPLETAR_RUTA_ABSOLUTA_VOLUMEN_STRESS

# =============================================================================
# COMPLETAR: PI WEB API REAL
# =============================================================================

# COMPLETAR: URL base real del PI Web API.
PI_WEB_API_BASE_URL=COMPLETAR_URL_PI_WEB_API

# COMPLETAR: nombre real del PI Data Archive usado para construir \\PI_SERVER\TAG.
PI_WEB_API_SERVER=COMPLETAR_PI_SERVER

# COMPLETAR: usuario Basic Auth de PI Web API.
PI_WEB_API_USERNAME=COMPLETAR_USUARIO_PI

# COMPLETAR: password Basic Auth de PI Web API.
PI_WEB_API_PASSWORD=COMPLETAR_PASSWORD_PI

# =============================================================================
# PI WEB API - VALORES PREPARADOS PARA EL STRESS
# =============================================================================

PI_WEB_API_CONNECT_TIMEOUT_SECONDS=5
PI_WEB_API_READ_TIMEOUT_SECONDS=30
PI_WEB_API_WRITE_TIMEOUT_SECONDS=30
PI_WEB_API_POOL_TIMEOUT_SECONDS=5
PI_WEB_API_MAX_RESPONSE_BYTES=67108864
PI_WEB_API_VERIFY_TLS=true
PI_WEB_API_ALLOW_INSECURE_HTTP=false

# Resolución de WebIDs. Con 185 tags físicos se resolverán en chunks de 100.
PI_WEB_API_POINTS_MAX_PATHS=100

# 185 tags físicos caben en una sola request interpolated por hora.
# Estimación máxima: 185 * 361 = 66.785 puntos, bajo la guarda de 150.000.
PI_WEB_API_INTERPOLATED_MAX_WEB_IDS=200

# El benchmark actual usa únicamente INTERPOLATED. Se conserva el valor productivo válido.
PI_WEB_API_RECORDED_MAX_WEB_IDS=100

# Cada iteración recupera como máximo una hora.
PI_WEB_API_MAX_RECOVERY_SECONDS=3600
PI_WEB_API_MAX_DATA_POINTS=150000

# =============================================================================
# STRESS BENCHMARK TEMPORAL
# =============================================================================

PI_WEB_API_STRESS_BENCHMARK=true

# Fan-out posterior a PI: 185 tags físicos reales -> 1000 columnas lógicas.
PI_WEB_API_STRESS_LOGICAL_TAGS=1000

# Construye un día UTC completo mediante hasta 24 ventanas sucesivas de una hora.
PI_WEB_API_STRESS_LOOKBACK_HOURS=24

# Día histórico completo usado para la prueba. Mantener exactamente este valor entre
# reejecuciones permite continuar desde el último watermark confirmado.
PI_WEB_API_STRESS_END_UTC=2026-08-14T23:59:50Z

# 0 = usar todos los tags físicos definidos en catalog/stress_definitions.py.
PI_WEB_API_STRESS_PHYSICAL_TAG_LIMIT=0

# =============================================================================
# OBSERVABILIDAD PARA MEDIR CPU / RAM / DURACIONES
# =============================================================================

ATLANTICUS_AZURE_OBSERVABILITY_MODE=preview
ATLANTICUS_AZURE_OBSERVABILITY_PROFILE=diagnostic

# No se usa con mode=preview. Dejar vacío.
APPLICATION_INSIGHTS_CONNECTION_STRING=
