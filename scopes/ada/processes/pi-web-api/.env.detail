# Copiar este archivo como .env para ejecución local.
# .env contiene valores reales y debe permanecer fuera del control de versiones.
#
# Contrato temporal del proceso:
# - todo se procesa y materializa en UTC;
# - no se conservan microsegundos;
# - la granularidad PI no se configura aquí;
# - catalog/definitions.py define PiWebApiSource(interpolation_seconds=...).
#
# El runtime despierta el job cada 1 segundo para detectar rápidamente un slot nuevo.
# Ese polling es local y no implica una llamada a PI mientras no exista un nuevo slot.

# =============================================================================
# RUNTIME ATLANTICUS
# =============================================================================

# Ambiente Atlanticus. Para desarrollo local debe ser local.
# En ambientes desplegados esta variable proviene del entorno del contenedor.
ENVIRONMENT=local

# Nombre lógico de la aplicación. Se utiliza para componer datasets, cache, estado y logs.
APPLICATION=ada

# Ruta absoluta del volumen persistente compartido por la aplicación.
VOLUMEN_PATH=/absolute/path/to/volume

# =============================================================================
# VALIDACIÓN LOCAL TEMPORAL DEL LEASE
# =============================================================================

# Modo temporal para validar exclusión y recuperación del lease sin conectarse a PI.
# Con true, el process NO carga catálogo, NO crea PiWebApiClient, NO resuelve WebIDs,
# NO consulta PI y NO toca datasets ni watermarks.
# Solo exige ENVIRONMENT=local, APPLICATION y VOLUMEN_PATH.
# Volver a false después de certificar las pruebas de handoff/crash.
PI_WEB_API_LEASE_SMOKE_MODE=false

# =============================================================================
# IDENTIDAD CORPORATIVA DE KEY VAULT
# =============================================================================

# Abreviatura de la empresa usada por atlanticus-key-vault para derivar:
# <company>-<environment>-kv-<product>
# Solo se necesita para resolver Key Vault en ambientes desplegados.
COMPANY_ABREV=company

# Abreviatura del producto/herramienta usada junto a COMPANY_ABREV y ENVIRONMENT.
# Solo se necesita para resolver Key Vault en ambientes desplegados.
PRODUCT_ABREV=product

# =============================================================================
# PI WEB API
# =============================================================================

# URL base del PI Web API. No debe contener usuario ni password embebidos.
PI_WEB_API_BASE_URL=https://pi-web-api.example.com/piwebapi

# Nombre del PI Data Archive. Se usa para construir internamente \\PI_SERVER\TAG.
PI_WEB_API_SERVER=PI_SERVER

# Usuario de Basic Auth. En local vive en .env; desplegado debe resolverse desde Key Vault.
PI_WEB_API_USERNAME=

# Password de Basic Auth. En local vive en .env; desplegado debe resolverse desde Key Vault.
PI_WEB_API_PASSWORD=

# Timeout para establecer la conexión HTTP, en segundos.
PI_WEB_API_CONNECT_TIMEOUT_SECONDS=5

# Timeout de lectura HTTP, en segundos. atlanticus-http no hace retry.
PI_WEB_API_READ_TIMEOUT_SECONDS=30

# Timeout de escritura HTTP, en segundos.
PI_WEB_API_WRITE_TIMEOUT_SECONDS=30

# Timeout esperando una conexión del pool HTTP, en segundos.
PI_WEB_API_POOL_TIMEOUT_SECONDS=5

# Tamaño máximo de una respuesta HTTP completa, en bytes. Default: 64 MiB.
PI_WEB_API_MAX_RESPONSE_BYTES=67108864

# Verificación TLS. Debe permanecer true en producción.
PI_WEB_API_VERIFY_TLS=true

# Permite HTTP sin TLS únicamente cuando se habilita explícitamente.
PI_WEB_API_ALLOW_INSECURE_HTTP=false

# Máximo de paths por points/multiple. El process hace los chunks; la integración valida.
PI_WEB_API_POINTS_MAX_PATHS=100

# Máximo de WebIDs por streamsets/interpolated. El process hace los chunks.
PI_WEB_API_INTERPOLATED_MAX_WEB_IDS=100

# Máximo de WebIDs por streamsets/recorded. El process hace los chunks.
PI_WEB_API_RECORDED_MAX_WEB_IDS=100

# Máximo horizonte automático de recuperación, en segundos. Default: una hora.
PI_WEB_API_MAX_RECOVERY_SECONDS=3600

# =============================================================================
# OBSERVABILIDAD AZURE
# =============================================================================

# Valores soportados: off, preview, export.
ATLANTICUS_AZURE_OBSERVABILITY_MODE=off

# Valores soportados: slim, diagnostic.
ATLANTICUS_AZURE_OBSERVABILITY_PROFILE=slim

# Obligatoria solamente con ATLANTICUS_AZURE_OBSERVABILITY_MODE=export.
# En despliegue debe resolverse desde Key Vault.
APPLICATION_INSIGHTS_CONNECTION_STRING=
