# Copiar este archivo como .env solo para ejecución local.
# .env contiene valores reales y no debe versionarse ni viajar en logs.
# Los valores mostrados aquí son ejemplos o defaults productivos certificados.

# Identidad del runtime.
# APPLICATION debe identificar de forma única este despliegue porque participa en state,
# datasets, leases y cache. Evitar compartirlo entre productores distintos.
ENVIRONMENT=local
APPLICATION=ada-pi-web-api
VOLUMEN_PATH=/absolute/path/to/volume

# Identidad organizacional usada por la resolución de configuración/Key Vault.
COMPANY_ABREV=company
PRODUCT_ABREV=product

# PI Web API.
# BASE_URL apunta a la raíz de PI Web API y SERVER identifica el PI Data Archive.
PI_WEB_API_BASE_URL=https://pi-web-api.example.com/piwebapi
PI_WEB_API_SERVER=PI_SERVER
PI_WEB_API_USERNAME=
PI_WEB_API_PASSWORD=

# HTTP.
# Mantener TLS habilitado en Azure/producción. ALLOW_INSECURE_HTTP solo existe para
# escenarios explícitos donde HTTP sin TLS sea realmente necesario.
PI_WEB_API_CONNECT_TIMEOUT_SECONDS=5
PI_WEB_API_READ_TIMEOUT_SECONDS=30
PI_WEB_API_WRITE_TIMEOUT_SECONDS=30
PI_WEB_API_POOL_TIMEOUT_SECONDS=5
PI_WEB_API_MAX_RESPONSE_BYTES=67108864
PI_WEB_API_VERIFY_TLS=true
PI_WEB_API_ALLOW_INSECURE_HTTP=false

# Límites PI Web API.
# POINTS controla resolución de WebIDs. INTERPOLATED y RECORDED controlan cuántos
# WebIDs viajan por request. INTERPOLATED puede ejecutar hasta 3 requests en paralelo.
PI_WEB_API_POINTS_MAX_PATHS=100
PI_WEB_API_INTERPOLATED_MAX_WEB_IDS=200
PI_WEB_API_INTERPOLATED_MAX_PARALLEL_REQUESTS=3
PI_WEB_API_RECORDED_MAX_WEB_IDS=100
PI_WEB_API_MAX_DATA_POINTS=150000

# Recovery.
# LOOKBACK limita cuánto pasado se conserva al volver de una caída.
# WINDOW limita cuánto de ese horizonte se procesa por iteración y nunca puede superar LOOKBACK.
# Con 3600/3600 se recupera como máximo la última hora en una ventana, salvo splits técnicos.
PI_WEB_API_MAX_RECOVERY_LOOKBACK_SECONDS=3600
PI_WEB_API_MAX_RECOVERY_WINDOW_SECONDS=3600

# Observabilidad Azure.
# off desactiva export Azure. preview permite validar localmente el payload de exportación.
# slim es el perfil operacional normal; diagnostic agrega detalle para investigación.
ATLANTICUS_AZURE_OBSERVABILITY_MODE=off
ATLANTICUS_AZURE_OBSERVABILITY_PROFILE=slim
APPLICATION_INSIGHTS_CONNECTION_STRING=
