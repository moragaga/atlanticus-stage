{
  "configuration": {
    "replicaTimeout": 300,
    "replicaRetryLimit": 0,
    "triggerType": "Schedule",
    "scheduleTriggerConfig": {
      "cronExpression": "0 */2 * * *",
      "parallelism": 1
    }
  },
  "template": {
    "container": {
      "name": "fabrica-service",
      "resources": {
        "cpu": 0.5,
        "memory": "1Gi"
      }
    }
  }
}
